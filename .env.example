# Copy to .env and fill in. Never commit .env.
# Load it for local runs with:  set -a; . ./.env; set +a

# --- Public URL of this app (no trailing slash). Locally, your tunnel URL (see README).
PUBLIC_BASE_URL=http://localhost:8080
# false for local http; leave unset (true) in production
COOKIE_SECURE=false

# --- Postgres. Neon: take the *direct* connection string (host without "-pooler")
#     postgresql://USER:PASSWORD@HOST/DB?sslmode=require  becomes:
DATABASE_URL=jdbc:postgresql://localhost:5432/relaybot
DATABASE_USERNAME=relaybot
DATABASE_PASSWORD=relaybot

# --- Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
# Registers /report and /status on startup (idempotent)
DISCORD_REGISTER_COMMANDS=true

# --- Dashboard login (single admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- Encrypts mirror webhook URLs at rest. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Optional: AI triage (free Groq key from https://console.groq.com). Leave empty to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
